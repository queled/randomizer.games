# ==================================
# RANDOMIZER.GAMES - Environment Variables
# Copy to .env and fill in. Never commit .env.
# ==================================

# --- Server ---
PORT=3000
NODE_ENV=development
# Public URL used for canonical links and the sitemap
SITE_URL=http://localhost:3000
# Required outside development: long random string (e.g. `openssl rand -hex 32`)
ADMIN_TOKEN=

# --- Database (MongoDB) ---
MONGODB_URI=mongodb://localhost:27017/randomizer

# --- Tournament sources ---
CHALLONGE_API_KEY=
CHALLONGE_USERNAME=
# https://start.gg/admin/profile/developer
STARTGG_API_TOKEN=

# --- Twitch (streams page, scripts/enrich-twitch.js) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- YouTube (restreams archived on YouTube, scripts/sync-race-restreams.js) ---
# Google Cloud console: API key with "YouTube Data API v3" enabled (10,000 units a day)
YOUTUBE_API_KEY=

# --- Google Search Console (admin Audience tab, read only) ---
# Google Cloud console: "Google Search Console API" enabled and a service account with a
# JSON key, added as a user of the property in Search Console. Path of that key, kept
# out of the repository:
# GOOGLE_SEARCH_CONSOLE_KEY_FILE=/home/randomizer/secrets/search-console.json
# Defaults to the Domain property of SITE_URL ("sc-domain:example.com")
# SEARCH_CONSOLE_SITE=

# --- Scheduled jobs (scripts/cron/run-job.sh and the admin Monitoring page) ---
# Defaults to ~/logs; must be the same for the server and the crontab
# LOG_DIR=/home/randomizer/logs

# --- Backups (scripts/backup-db.js, optional overrides) ---
# BACKUP_DIR=./backups
# BACKUP_KEEP=7

# --- Rando-list sync (optional overrides) ---
# RANDO_LIST_REPO=https://github.com/video-game-randomizers/rando-list.git
# RANDO_LIST_BRANCH=main
# RANDO_LIST_DIR=./scripts/tmp/rando-list

# --- Rate limits for external APIs, in ms (optional) ---
# RACETIME_RATE_LIMIT_MS=
# SRL_RATE_LIMIT_MS=
