# ==================================
# RANDOMIZER.GAMES - Environment Variables
# ==================================

# Server Configuration
PORT=3000
NODE_ENV=production
ADMIN_TOKEN=change_me_with_a_long_random_token

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/randomizer

# Or PostgreSQL (choose one)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=randomizer
# POSTGRES_USER=your_username
# POSTGRES_PASSWORD=your_password

# API Keys
CHALLONGE_API_KEY=your_challonge_api_key
CHALLONGE_USERNAME=your_challonge_username

# Racetime.gg (no key needed, public API)
RACETIME_BASE_URL=https://racetime.gg

# Twitch API (for streams feature)
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# Rando List Sync Configuration
REPO_URL=https://github.com/video-game-randomizers/rando-list.git
REPO_BRANCH=main
TMP_DIR=/tmp/rando-list
OUTPUT_CSV=./scripts/rando-list.csv
MONGO_COLLECTION=rando_list

# Cache Configuration
CACHE_TTL=3600

# Sync Configuration (cron schedule)
SYNC_SCHEDULE=0 */6 * * *

# ==================================
# Security Notes:
# ==================================
# - Never commit .env file with real values
# - Use strong, unique passwords
# - Rotate secrets regularly (especially API keys)
# - Use environment-specific values (dev/staging/prod)
# - For production, consider using a secrets manager
# ==================================

