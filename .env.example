# ==================================
# RANDOMIZER.GAMES - Environment Variables
# Copy to .env and fill in. Never commit .env.
# ==================================

# --- Server ---
PORT=3000
NODE_ENV=development
# Public URL used for canonical links and the sitemap
SITE_URL=http://localhost:3000
# Required outside development: long random string (e.g. `openssl rand -hex 32`)
ADMIN_TOKEN=

# --- Database (MongoDB) ---
MONGODB_URI=mongodb://localhost:27017/randomizer

# --- Tournament sources ---
CHALLONGE_API_KEY=
CHALLONGE_USERNAME=
# https://start.gg/admin/profile/developer
STARTGG_API_TOKEN=

# --- Twitch (streams page, scripts/enrich-twitch.js) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Admin panel: GitHub Actions status (optional) ---
# Fine-grained token with read-only "Actions" permission on the repo
GITHUB_TOKEN=
GITHUB_REPO=queled/randomizer.games

# --- Rando-list sync (optional overrides) ---
# RANDO_LIST_REPO=https://github.com/video-game-randomizers/rando-list.git
# RANDO_LIST_BRANCH=main
# RANDO_LIST_DIR=./scripts/tmp/rando-list

# --- Rate limits for external APIs, in ms (optional) ---
# RACETIME_RATE_LIMIT_MS=
# SRL_RATE_LIMIT_MS=
