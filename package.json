{
  "name": "randomizer",
  "version": "2.0.0",
  "private": true,
  "description": "Centralized platform for randomizer tournaments, runs, and statistics",
  "main": "server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "sync": "npm run sync:racetime && npm run sync:players && npm run sync-rando-list",
    "sync:racetime": "node scripts/sync-racetime-global.js",
    "sync:speedrunslive": "node scripts/sync-speedrunslive.js --all",
    "sync:players": "node scripts/sync-players-from-races.js",
    "sync:players:dry": "node scripts/sync-players-from-races.js --dry-run",
    "sync:tournaments": "node scripts/sync-tournaments.js",
    "sync:tournaments:dry": "node scripts/sync-tournaments.js --dry-run",
    "sync:tournaments:update": "node scripts/sync-tournaments.js --update-only",
    "link:tournaments:active": "node scripts/auto-link-tournaments.js",
    "sync:schedule-sites": "node scripts/sync-schedule-sites.js",
    "sync:schedule-sites:dry": "node scripts/sync-schedule-sites.js --dry-run",
    "sync:midos-league": "node scripts/sync-midos-league.js",
    "sync:midos-league:dry": "node scripts/sync-midos-league.js --dry-run",
    "sync:speedrace": "node scripts/sync-speedrace.js",
    "sync:speedrace:dry": "node scripts/sync-speedrace.js --dry-run",
    "sync:race-vods": "node scripts/sync-race-vods.js",
    "sync:race-vods:dry": "node scripts/sync-race-vods.js --dry-run",
    "sync:race-restreams": "node scripts/sync-race-restreams.js",
    "sync:race-restreams:dry": "node scripts/sync-race-restreams.js --dry-run",
    "discover:tournaments": "node scripts/discover-tournaments.js",
    "discover:tournaments:dry": "node scripts/discover-tournaments.js --dry-run",
    "discover:tournaments:startgg": "node scripts/discover-tournaments.js --source startgg",
    "discover:tournaments:challonge": "node scripts/discover-tournaments.js --source challonge",
    "discover:tournaments:hth": "node scripts/discover-tournaments.js --source hth",
    "import:startgg": "node scripts/import-startgg.js",
    "import:challonge": "node scripts/import-challonge.js",
    "link:startgg-races": "node scripts/link-startgg-races.js",
    "link:challonge-races": "node scripts/link-challonge-races.js",
    "link:qualifiers": "node scripts/link-qualifier-races.js --all",
    "sync-rando-list": "node scripts/sync-rando-list.js",
    "sync-rando-list:link": "node scripts/sync-rando-list.js --link-games",
    "sync-rando-list:detect": "node scripts/sync-rando-list.js --detect-new",
    "import-games": "node scripts/import-games-csv.js",
    "import:multiworld-manual": "node scripts/import-multiworld-manual.js",
    "enrich-games": "node scripts/enrich-games.js",
    "db:backup": "node scripts/backup-db.js",
    "check-security": "node scripts/check-security.js",
    "predeploy": "npm run check-security"
  },
  "keywords": [
    "randomizer",
    "speedrun",
    "tournament",
    "racetime",
    "statistics"
  ],
  "author": "queled",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "js-yaml": "^5.4.3",
    "mongoose": "^9.11.2",
    "sanitize-html": "^2.18.1",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
